# =====================================================================
#  환경변수 예시 — 실제 값은 절대 커밋하지 말 것.
#  로컬:   이 파일을 `.env` 로 복사한 뒤 값을 채운다 (.env 는 .gitignore).
#  잡:     GitHub repo Secrets 로 주입 (레이어 A / 파이프라인).
#  서빙:   Fly/Render 환경변수로 주입 (레이어 B / FastAPI).
#  프론트: Vercel 환경변수로 주입 (레이어 C).
# =====================================================================

# --- Supabase (PostgreSQL) ---
# 파이프라인(쓰기)은 service_role 키 사용. FastAPI(읽기)는 anon 키 권장.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- Google Gemini API (무료 티어, Google AI Studio 발급) ---
GEMINI_API_KEY=your-gemini-api-key

# --- 네이버 뉴스 검색 API (개발자센터 발급) ---
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# --- FastAPI 서빙 레이어 (M6 에서 사용) ---
# 프론트 도메인만 CORS 허용. 콤마로 여러 개 가능.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
